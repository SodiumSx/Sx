{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/loader.lua", "destination": "/" },
    { "source": "/tool_giai_loader.py", "destination": "/" },
    { "source": "/tool_giai_executor.lua", "destination": "/" },
    { "source": "/tools/:f*", "destination": "/" },
    { "source": "/SECURITY.md", "destination": "/" },
    { "source": "/package.json", "destination": "/" },
    { "source": "/vercel.json", "destination": "/" },
    { "source": "/.env", "destination": "/" },
    { "source": "/.env.local", "destination": "/" },
    { "source": "/api/_:file*", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/api/(raw|payload|verify)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noai, noimageai" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noai, noimageai" }
      ]
    }
  ]
}
